{
 "cleanUrls": true,
 "rewrites": [
  {
   "source": "/",
   "destination": "/app"
  }
 ],
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Permissions-Policy",
     "value": "microphone=(self)"
    }
   ]
  }
 ]
}